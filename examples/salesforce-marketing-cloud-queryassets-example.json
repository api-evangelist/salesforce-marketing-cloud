          "property": "assetType.name",
          "simpleOperator": "equal",
          "value": "htmlemail"
        },
        "sort": [
          {
            "property": "modifiedDate",
            "direction": "DESC"
          }
        ],
        "fields": [
          "id",
          "name",
          "assetType",
          "modifiedDate"
        ]
      }
    }
  ],
  "responseExamples": []
}